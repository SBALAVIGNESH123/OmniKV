# OmniKV example server configuration.
#
# This file is safe to commit and ship in containers: it intentionally does
# not contain runtime secrets. Set OMNIKV_JWT_SECRET and
# OMNIKV_BOOTSTRAP_ADMIN_KEY through your orchestrator, secret manager, or
# local environment.

mode = "production"
http_addr = "0.0.0.0:8443"
quic_addr = "0.0.0.0:4433"
pgwire_addr = "0.0.0.0:5433"
tcp_addr = "0.0.0.0:8080"
log_level = "info,omni_engine=debug"

# TLS identity. A real deployment mounts its own certificate and key:
#
#   tls_cert_path = "/etc/omni/tls/fullchain.pem"   # leaf first, then intermediates
#   tls_key_path  = "/etc/omni/tls/privkey.pem"
#
# Both TLS listeners (HTTP/2 and QUIC) then present that certificate, and
# clients can verify the server against the signing CA. The two lines below
# are the demo posture: with no operator certificate configured the server
# generates an ephemeral self-signed certificate on every boot, which
# nothing can verify — set tls_insecure_skip to acknowledge that.
tls_insecure_skip = true

[storage]
manifest_path = "/data/manifest.json"
wal_path = "/data/wal.bin"
backup_dir = "/data/backups"
max_open_files = 512
write_buffer_mb = 64
compaction_workers = 2
memtable_flush_threshold = 10000
l0_compaction_trigger = 4
l1_compaction_trigger = 4
l0_write_stall_threshold = 12
write_stall_wait_attempts = 50
write_stall_wait_ms = 100
compaction_check_interval_ms = 500
